PORT=4173

# 阿里云百炼统一网关：DeepSeek 文本、千问视觉、千问语音共用一个 API Key
DASHSCOPE_API_KEY=

# 标准百炼兼容地址；若使用业务空间专属地址，请替换为控制台显示的 compatible-mode/v1 地址
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=deepseek-v4-flash
BAILIAN_VISION_MODEL=qwen3-vl-flash
BAILIAN_ASR_MODEL=qwen3-asr-flash

# MinerU 精准解析 API：用于 PDF、Office、扫描件、公式、表格和版面解析
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_ENABLE_OCR=true
MINERU_LANGUAGE=ch
MINERU_POLL_INTERVAL_MS=3000
MINERU_TIMEOUT_MS=900000

# MinerU 结果中没有图意文本的插图/图表，再由百炼视觉补充：smart=仅缺失项；off=关闭；full=全部图片
MATERIAL_IMAGE_ENRICHMENT=smart

# 未配置 MinerU 时的本地兼容解析策略
MATERIAL_VISION_MODE=smart
